{
  "name": "@applywise/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@applywise/job-engine": "workspace:*",
    "@applywise/resume-engine": "workspace:*",
    "@applywise/types": "workspace:*",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@applywise/config": "workspace:*",
    "@types/node": "^22.18.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.5",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
