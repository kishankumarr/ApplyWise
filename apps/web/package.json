    "@applywise/types": "workspace:*",
    "@applywise/ui": "workspace:*",
    "@applywise/validation": "workspace:*",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.5",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.61.2",
    "docx": "^9.5.1",
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.2",
