# ApplyWise environment template. Copy to .env and fill in values.
# NEVER commit real secrets. All variables are validated at start-up (apps/web/src/env.ts).

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ApplyWise
# postgres from docker-compose (port 5433 on the host)
DATABASE_URL=postgresql://applywise:applywise@localhost:5433/applywise

# --- Auth (Auth.js) ---------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true

# --- Crypto -----------------------------------------------------------------
# 32-byte base64 key used for AES-256-GCM encryption of resumes/extracted text at rest.
ENCRYPTION_KEY=
# HMAC secret (>= 32 chars) for email-send confirmations and extension prefill payloads.
SIGNING_SECRET=

# --- Storage ----------------------------------------------------------------
# local | s3  (s3 also covers Cloudflare R2 / MinIO via S3_ENDPOINT)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_MB=5
# none | clamav (clamav requires CLAMAV_HOST/CLAMAV_PORT; stub scanner otherwise)
MALWARE_SCANNER=none
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- AI provider ------------------------------------------------------------
# anthropic (Claude API) | ollama (local open-weight model) | openai_compatible (vLLM, LM Studio, llama.cpp, hosted open models)
# With no provider configured, or AI_DISABLED=true, deterministic rule-based fallbacks are used.
AI_PROVIDER=anthropic

# Anthropic Claude
# Leave empty to use the deterministic fallback (rule-based parsing, matching and drafts).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Server-side refusal fallbacks (beta). Set false if your proxy rejects the parameter.
ANTHROPIC_SERVER_FALLBACKS=true

# Ollama (https://ollama.com) - run `ollama pull qwen2.5:7b` first
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Context window requested from the model (Ollama's default is too small for CVs)
OLLAMA_NUM_CTX=8192

# OpenAI-compatible server (only when AI_PROVIDER=openai_compatible)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_API_KEY=

# Shared AI settings
# Attempts per call (1-5) and the base retry backoff in ms
AI_MAX_ATTEMPTS=3
AI_BACKOFF_MS=500
# Request timeout; defaults to 120000 for Claude and 300000 for local models
AI_TIMEOUT_MS=
AI_TEMPERATURE=0.2
AI_DISABLED=false

# --- Background jobs --------------------------------------------------------
# inline (run immediately, awaited) | memory (in-process worker) | bullmq (requires REDIS_URL)
# A separate worker process (pnpm worker) only receives the web app's tasks with bullmq; memory queues are per process.
QUEUE_DRIVER=memory
# e.g. redis://localhost:6379 (docker compose --profile queue up -d redis)
REDIS_URL=
# Web process in production: set true so Next.js only enqueues and the dedicated worker consumes every queue.
# (Read directly from the environment, not validated in apps/web/src/env.ts.)
# APPLYWISE_DISABLE_WORKER=true

# --- Email ------------------------------------------------------------------
# dev (writes to EMAIL_OUTBOX_DIR, never delivers) | smtp (Mailpit/Mailtrap/relay) | resend
EMAIL_PROVIDER=dev
EMAIL_FROM="ApplyWise <no-reply@applywise.test>"
EMAIL_OUTBOX_DIR=.outbox
# Mailpit from docker-compose: SMTP_HOST=localhost SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Only set true for a real relay; Mailpit/Mailtrap only capture mail.
SMTP_DELIVERS_EXTERNALLY=false
RESEND_API_KEY=

# --- Security ---------------------------------------------------------------
# Comma-separated extension origins allowed to call /api/extension/* and /api/jobs/import/browser
# e.g. chrome-extension://<your-extension-id>
EXTENSION_ORIGINS=
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

# --- Development helpers ----------------------------------------------------
# Enables /admin/demo-data (never enable in production).
ENABLE_DEMO_ADMIN=true

# --- Automatic job sources (docs/job-sources.md) ------------------------------
# In-process scheduler of the web server (safe with several instances). Set off on the web process when the dedicated
# worker (pnpm worker, WORKER_ROLES=...,scheduler) runs the scheduler; the worker ignores this flag.
FEEDS_SCHEDULER=on
FEEDS_TICK_SECONDS=300
# Adzuna: on-site/hybrid jobs across Indian cities. Free key: https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Real API calls this server may make (Adzuna's default terms: 250/day, 1000/week, 2500/month)
ADZUNA_DAILY_LIMIT=200
ADZUNA_WEEKLY_LIMIT=900
ADZUNA_MONTHLY_LIMIT=2300
# Optional: raises The Muse's rate limit (works without a key)
THE_MUSE_API_KEY=
# Optional "Sign in with Google" for Gmail (read-only scope). Redirect URI: <APP_URL>/api/job-feeds/mailbox/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional "Connect Outlook" (device-code sign-in; public client, no secret)
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT=common
# Optional private forwarding addresses (hosted): see infra/cloudflare-email-worker/README.md
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=
# Let users enter their own IMAP host (self-hosted setups only)
ALLOW_CUSTOM_IMAP_HOST=false

# --- Automation (docs/AUTOMATION_ARCHITECTURE.md) ------------------------------
# Every user starts with automation OFF and in MANUAL mode (nothing is submitted); these are operator limits.
# In-process automation scheduler of the web server (runs, deferred submissions, crash recovery, status sync,
# notifications, daily summaries). Set off on the web process when the dedicated worker runs the scheduler.
AUTOMATION_SCHEDULER=on
AUTOMATION_TICK_SECONDS=60
# Upper bound for every user's "applications per day" setting (1-500).
AUTOMATION_MAX_DAILY_LIMIT=50
# Jobs evaluated per automation run (10-5000).
AUTOMATION_MAX_JOBS_PER_RUN=500
# Applications prepared per run (bounds AI cost; default 25). Left unset here so `pnpm demo:automation` can raise it
# to 60 for the demo; set it to pin the value for every process.
# AUTOMATION_MAX_PREPARE_PER_RUN=25
# Concurrency of the BullMQ "applywise-apply" queue (submissions; the browser executor opens one Chromium per job).
APPLY_QUEUE_CONCURRENCY=2
# Fictional demo provider (DEMO CONTENT). Empty = on outside production, off in production; true/false overrides.
DEMO_PROVIDER_ENABLED=

# Browser executor: Playwright + Chromium inside the worker, never the user's browser. OFF by default.
# It never solves CAPTCHAs or MFA and never signs in; those end in a manual handoff.
# Chromium: pnpm --filter @applywise/web exec playwright-core install chromium (add --with-deps on Linux).
BROWSER_EXECUTOR_ENABLED=false
# Providers it may run for: demo (the local /demo/ats pages). greenhouse,lever,ashby are EXPERIMENTAL (not validated
# against the live sites) - opt in only deliberately.
BROWSER_EXECUTOR_PROVIDERS=demo
# Fill the form but never press submit (the application ends in a manual handoff).
BROWSER_EXECUTOR_DRY_RUN=false
BROWSER_EXECUTOR_HEADLESS=true
# Navigation/action timeout and how long to wait for the confirmation (5000-600000 ms).
BROWSER_EXECUTOR_TIMEOUT_MS=60000

# Dedicated worker (pnpm worker). Health endpoint: GET http://localhost:<port>/health (0 disables it).
WORKER_HEALTH_PORT=3200
# Roles of the worker process: worker (consume the queues), scheduler (feeds + automation ticks). Default both.
# Read by the worker only; do not leave it empty (an empty value means "no roles").
# WORKER_ROLES=worker,scheduler

# --- Integration stubs (disabled by default; require partner approval) --------
ENABLE_PARTNER_API=false
PARTNER_API_URL=
PARTNER_API_KEY=
ENABLE_PARTNER_FEED=false
PARTNER_FEED_URL=
PARTNER_FEED_KEY=
ENABLE_ATS_BOARD_APIS=false
